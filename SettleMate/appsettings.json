{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SettleMate_DB;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "EmailSettings": {
    "Host": "YOUR_SMTP_HOST",
    "Port": 587,
    "Username": "YOUR_EMAIL_ADDRESS",
    "Password": "YOUR_EMAIL_PASSWORD_OR_APP_PASSWORD",
    "FromEmail": "YOUR_EMAIL_ADDRESS",
    "FromName": "SettleMate",
    "EnableSsl": true
  },

  "SessionSettings": {
    "IdleTimeoutMinutes": 30
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}